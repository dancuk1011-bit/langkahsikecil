{
  "name": "langkah-si-kecil-netlify-export",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean:dist && npm run validate:content && npm run typecheck && vite build",
    "preview": "vite preview",
    "validate:content": "node scripts/validate-content.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src content/engine netlify/functions tests",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.1",
    "@netlify/functions": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.0.13"
  }
}
